{
  "env": {
    "node": true,
    "commonjs": true,
    "es2021": true,
    "mocha": true
  },
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": "latest"
  },
  "rules": {
    "class-methods-use-this": "off",
    "arrow-parens": "off",
    "prefer-arrow-callback": "off",
    "func-names": "off",
    "object-curly-newline": "off",
    "no-unused-expressions": "off",
    "no-restricted-syntax": "off",
    "no-await-in-loop": "off",
    "max-len": [
      "error",
      {
        "code": 100,
        "ignoreComments": true
      }
    ]
  },
  "globals": {
    "browser": "readonly",
    "expect": "readonly",
    "$": "readonly",
    "$$": "readonly"
  }
}
